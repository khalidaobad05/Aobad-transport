# === قاعدة البيانات ===
# محلي: لا تغير شيئاً (يعمل بدون إنترنت)
DATABASE_URL=file:./db/custom.db

# سحابي (Turso - مجاني): عدّل السطرين التاليين بعد إنشاء قاعدة Turso
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=your-auth-token

# === المصادقة ===
# كلمة سر الدخول للموظفين (اختياري - الافتراضي: 1234)
# AUTH_PASSWORD=1234
