generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id        String   @id @default(cuid())
  code      Int      @unique
  name      String
  phone     String?
  address   String?
  ifu       String?
  ice       String?
  rc        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders   Order[]
  invoices Invoice[]
}

model Vehicle {
  id           String   @id @default(cuid())
  registration String   @unique
  driverName   String
  ownerName    String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shipments Shipment[]
  expenses  Expense[]
}

// Shipment = a trip made by a vehicle on a given date
// Contains multiple orders for different customers
model Shipment {
  id            String   @id @default(cuid())
  number        Int      @unique
  date          DateTime
  status        String   @default("قيد التوصيل")
  description   String?
  generator     String?
  totalExpected Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  orders   Order[]
  expenses Expense[]
}

// Order = individual customer delivery within a shipment
model Order {
  id           String   @id @default(cuid())
  packageCount Int      @default(0)
  price        Float?
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id])
}

model Expense {
  id          String   @id @default(cuid())
  number      String   @unique
  date        DateTime
  type        String
  amount      Float
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shipmentId String?
  shipment   Shipment?  @relation(fields: [shipmentId], references: [id])
  vehicleId  String
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id])
}

model Invoice {
  id              String   @id @default(cuid())
  number          String   @unique
  date            DateTime
  paymentMethod   String   @default("نقدي")
  htAmount        Float    @default(0)
  tvaRate         Float    @default(20)
  tvaAmount       Float    @default(0)
  taxeProfRate    Float    @default(0)
  taxeProfAmount  Float    @default(0)
  ttcAmount       Float    @default(0)
  timbreFiscal    Float    @default(0)
  status          String   @default("غير مدفوعة")
  notes           String?
  companyInfo     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clientId String
  client   Client  @relation(fields: [clientId], references: [id])
}

model Employee {
  id        String   @id @default(cuid())
  fullName  String
  accessCode String   @unique
  role      String   @default("موظف") // مسير or موظف
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
